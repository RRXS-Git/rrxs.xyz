---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('vlog');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<Layout title="Vlog — RRXS / 千锤百问">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h1 class="text-4xl md:text-5xl font-display font-bold mb-4 text-center gradient-heading">Vlog</h1>
    <p class="text-lg text-muted-foreground text-center mb-12 max-w-2xl mx-auto">视频记录 · 实战演示 · 系统拆解</p>

    {sortedPosts.length === 0 ? (
      <div class="text-center py-20">
        <p class="text-muted-foreground text-lg">视频内容正在录制中，敬请期待…</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {sortedPosts.map((post) => (
          <a href={`/vlog/${post.slug}`} class="nebula-card rounded-xl overflow-hidden group block">
            {post.data.heroImage && (
              <div class="aspect-video bg-nebula-800/50 overflow-hidden">
                <img src={post.data.heroImage} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
              </div>
            )}
            <div class="p-5">
              <div class="flex items-center gap-3 mb-3">
                <time class="text-xs text-nebula-400/70 font-mono">{post.data.pubDate.toLocaleDateString('zh-CN')}</time>
                {post.data.duration && (
                  <span class="text-xs bg-nebula-700/50 px-2 py-0.5 rounded text-nebula-300">{post.data.duration}</span>
                )}
              </div>
              <h2 class="text-lg font-semibold text-card-foreground group-hover:text-nebula-300 transition-colors mb-2 line-clamp-2">{post.data.title}</h2>
              <p class="text-sm text-muted-foreground line-clamp-2">{post.data.description}</p>
              {post.data.tags && (
                <div class="mt-3 flex flex-wrap gap-1.5">
                  {post.data.tags.map((tag) => (
                    <span class="text-xs bg-nebula-800/40 px-2 py-0.5 rounded text-nebula-400">#{tag}</span>
                  ))}
                </div>
              )}
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</Layout>
