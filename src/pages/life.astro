---
import Layout from '../layouts/Layout.astro';
---

<Layout title="心灵生活 — RRXS / 千锤百问">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h1 class="text-4xl md:text-5xl font-display font-bold mb-12 text-center gradient-heading">心灵生活</h1>

    <div class="max-w-4xl mx-auto space-y-8">
      <section class="nebula-card p-8 rounded-xl">
        <h2 class="text-2xl font-display font-semibold mb-4 text-foreground">故事分享</h2>
        <ul class="list-disc list-inside text-muted-foreground leading-relaxed space-y-2">
          <li>亲子</li>
          <li>成长</li>
          <li>启发</li>
        </ul>
      </section>

      <section class="nebula-card p-8 rounded-xl">
        <h2 class="text-2xl font-display font-semibold mb-4 text-foreground">情感疗愈</h2>
        <ul class="list-disc list-inside text-muted-foreground leading-relaxed space-y-2">
          <li>积极语录</li>
          <li>激励短片</li>
        </ul>
      </section>

      <section class="nebula-card p-8 rounded-xl">
        <h2 class="text-2xl font-display font-semibold mb-4 text-foreground">生活记录</h2>
        <ul class="list-disc list-inside text-muted-foreground leading-relaxed space-y-2">
          <li>旅行</li>
          <li>日常反思</li>
        </ul>
      </section>

      <section class="nebula-card p-8 rounded-xl">
        <h2 class="text-2xl font-display font-semibold mb-4 text-foreground">图片视频墙</h2>
        <p class="text-muted-foreground leading-relaxed">这里将展示治愈系视觉内容。</p>
      </section>
    </div>
  </div>
</Layout>
