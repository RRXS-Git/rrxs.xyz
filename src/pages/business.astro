---
import Layout from '../layouts/Layout.astro';
---

<Layout title="商务板块 — RRXS / 千锤百问">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h1 class="text-4xl md:text-5xl font-display font-bold mb-12 text-center gradient-heading">商务板块</h1>

    <div class="max-w-4xl mx-auto space-y-8">
      <section class="nebula-card p-8 rounded-xl">
        <h2 class="text-2xl font-display font-semibold mb-4 text-foreground">营销</h2>
        <ul class="list-disc list-inside text-muted-foreground leading-relaxed space-y-2">
          <li>B2B战略</li>
          <li>AI驱动营销案例</li>
        </ul>
      </section>

      <section class="nebula-card p-8 rounded-xl">
        <h2 class="text-2xl font-display font-semibold mb-4 text-foreground">自媒体共进</h2>
        <ul class="list-disc list-inside text-muted-foreground leading-relaxed space-y-2">
          <li>小红书 / 抖音运营</li>
          <li>AI短视频脚本库</li>
        </ul>
      </section>

      <section class="nebula-card p-8 rounded-xl">
        <h2 class="text-2xl font-display font-semibold mb-4 text-foreground">电商</h2>
        <ul class="list-disc list-inside text-muted-foreground leading-relaxed space-y-2">
          <li>营销方案</li>
          <li>案例分享</li>
        </ul>
      </section>

      <section class="nebula-card p-8 rounded-xl">
        <h2 class="text-2xl font-display font-semibold mb-4 text-foreground">财经金融（期货期权）</h2>
        <ul class="list-disc list-inside text-muted-foreground leading-relaxed space-y-2">
          <li>基础知识</li>
          <li>每日新闻精选</li>
          <li>策略分享</li>
        </ul>
      </section>

      <section class="nebula-card p-8 rounded-xl">
        <h2 class="text-2xl font-display font-semibold mb-4 text-foreground">智能洗车（苗喜）</h2>
        <ul class="list-disc list-inside text-muted-foreground leading-relaxed space-y-2">
          <li>项目介绍</li>
          <li>加盟/投资方案</li>
          <li>案例与门店展示</li>
        </ul>
      </section>
    </div>
  </div>
</Layout>
