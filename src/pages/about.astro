---
import Layout from '../layouts/Layout.astro';
---

<Layout title="关于我 — RRXS / 千锤百问">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h1 class="text-4xl md:text-5xl font-display font-bold mb-12 text-center gradient-heading">关于我</h1>

    <div class="max-w-4xl mx-auto space-y-8">
      <section class="nebula-card p-8 rounded-xl">
        <h2 class="text-2xl font-display font-semibold mb-4 text-foreground">个人简介</h2>
        <p class="text-muted-foreground leading-relaxed">这里是我的个人简介内容。</p>
      </section>

      <section class="nebula-card p-8 rounded-xl">
        <h2 class="text-2xl font-display font-semibold mb-4 text-foreground">我的旅程（学习 & 创业）</h2>
        <p class="text-muted-foreground leading-relaxed">这里是我的学习和创业旅程。</p>
      </section>

      <section class="nebula-card p-8 rounded-xl">
        <h2 class="text-2xl font-display font-semibold mb-4 text-foreground">价值观与使命</h2>
        <p class="text-muted-foreground leading-relaxed">这里是我的价值观和使命。</p>
      </section>
    </div>
  </div>
</Layout>
